# Model ID sent in API calls (BytePlus Ark "Responses API")
BYTEPLUS_MODEL=deepseek-v4-flash-260425
# Console's Endpoint ID — reference only, not sent in requests
BYTEPLUS_ENDPOINT=your_endpoint_id_here
BYTEPLUS_API_KEY=your_api_key_here
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3/responses

# Fallback providers (uncomment to switch)
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key

# LLM Provider: byteplus | openai | anthropic
LLM_PROVIDER=byteplus

# Demo mode: true = use cached data, false = call LLM API
DEMO_MODE=true

# --- Wealify API (live data from sponsor) ---
# Shared BTC sample account — safe to use as-is, no setup needed.
WEALIFY_API_URL=https://dev-api.wealify.com/api
WEALIFY_VC_API_URL=https://dev-api.virtual-card.wealify.com/api
WEALIFY_EMAIL=wealifytester@yopmail.com
WEALIFY_PASSWORD=Wealify@123
# App always uses live Wealify data; there is no mock/fake fallback.
USE_LIVE_WEALIFY=true

# --- Gmail API (read-only inbox for email reconciliation) ---
# Requires backend/gmail_credentials.json + backend/gmail_token.json
# (provided separately by the team, not committed to this repo — see README).
USE_GMAIL_API=false

# --- Outbound email (self-notify reports — only ever sent to USER_EMAIL) ---
# The user's own address. Reports are drafted and, once confirmed, sent here.
USER_EMAIL=
# Sent via the Gmail API (same credentials as USE_GMAIL_API above, scoped to
# gmail.readonly + gmail.send only — never insert/modify) when USE_GMAIL_API=true
# and gmail_credentials.json is present. SMTP below is only a fallback if
# Gmail API isn't set up. If neither is configured, "confirm to send" shows
# the draft instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Periodic monitoring ---
# How often (seconds) the background job re-fetches data and re-scans for
# new findings. Logs only — never sends email on its own. Lower this for a
# live demo (e.g. 30-60) so new findings show up quickly; 300 (5 min) by default.
SCHEDULED_CHECK_INTERVAL_SECONDS=300
